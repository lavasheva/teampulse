{
  "name": "@teampulse/analytics",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@teampulse/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "typescript": "~5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["<rootDir>/test/**/*.spec.ts"],
    "transform": { "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.test.json" }] }
  }
}
