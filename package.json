{
  "name": "teampulse",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @teampulse/web dev",
    "dev:api": "pnpm --filter @teampulse/api dev",
    "start:api": "pnpm --filter @teampulse/api start",
    "lint": "pnpm -r --if-present lint",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @teampulse/web test:e2e",
    "test:e2e:api": "pnpm --filter @teampulse/api build && pnpm --filter @teampulse/web test:e2e:api"
  }
}
