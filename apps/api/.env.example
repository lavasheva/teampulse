DATABASE_URL=postgresql://teampulse:teampulse@localhost:5432/teampulse?schema=public
REDIS_URL=redis://localhost:6379
HOST=127.0.0.1
PORT=3000
TRUST_PROXY_HOPS=0
WEB_ORIGIN=http://localhost:5173
# Register a GitHub OAuth App for local login. Never commit real secrets.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# GitHub App (separate from the OAuth App above).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# Enable the Redis/BullMQ worker and outbox dispatcher after configuring Redis.
GITHUB_EVENTS_ENABLED=false
GITHUB_QUEUE_NAME=github-deliveries
