{
  "name": "@teampulse/api",
  "private": true,
  "scripts": {
    "dev": "tsc && concurrently -k \"tsc --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=.env dist/main.js\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:smoke": "node --env-file-if-exists=.env scripts/smoke.cjs",
    "test:integration": "node --env-file-if-exists=.env scripts/integration.cjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "6.19.0",
    "@nestjs/throttler": "^6.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "bullmq": "^5.61.0",
    "express": "^5.1.0",
    "octokit": "^5.0.5",
    "zod": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/jest": "^29.5.14",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "prisma": "6.19.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.6",
    "typescript": "~5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["<rootDir>/test/**/*.spec.ts"],
    "transform": { "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.json" }] }
  }
}
