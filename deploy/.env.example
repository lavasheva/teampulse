TEAMPULSE_IMAGE_TAG=local
POSTGRES_DB=teampulse
POSTGRES_USER=teampulse
POSTGRES_PASSWORD=replace-with-random-hex-password
DATABASE_URL=postgresql://teampulse:replace-with-random-hex-password@postgres:5432/teampulse?schema=public
REDIS_URL=redis://redis:6379
SITE_ADDRESS=teampulse.example.com
WEB_ORIGIN=https://teampulse.example.com
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://teampulse.example.com/api/auth/github/callback
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Absolute path on the server; mounted read-only as a Compose secret.
GITHUB_APP_PRIVATE_KEY_FILE=/opt/teampulse-secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_EVENTS_ENABLED=true
GITHUB_QUEUE_NAME=github-deliveries
